<odoo noupdate="1">
<record id="sequence_promotion_code" model="ir.sequence">
    <field name="name">Promotion Code</field>
    <field name="code">promotion_code</field>
    <field name="prefix">PC/%(range_year)s/</field>
    <field eval="1" name="number_next" />
    <field eval="1" name="number_increment" />
    <field name="padding" eval="6" />
    <field name="use_date_range" eval="1" />
</record>
</odoo>
