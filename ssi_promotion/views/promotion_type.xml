<odoo>
<record id="promotion_type_view_search" model="ir.ui.view">
    <field name="name">promotion_type - search</field>
    <field name="model">promotion_type</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='code']" position="after">
                <field name="discount_type" />
            </xpath>
        </data>
    </field>
</record>

<record id="promotion_type_view_tree" model="ir.ui.view">
    <field name="name">promotion_type - tree</field>
    <field name="model">promotion_type</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='active']" position="after">
                <field name="discount_type" />
                <field name="usage_limit" />
                <field name="has_validity" />
            </xpath>
        </data>
    </field>
</record>

<record id="promotion_type_view_form" model="ir.ui.view">
    <field name="name">promotion_type - form</field>
    <field name="model">promotion_type</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//notebook/page[@name='note']" position="before">
                <page name="discount" string="Discount">
                    <group name="discount_group" string="Discount">
                        <field name="discount_type" />
                        <field
                                name="discount_amount"
                                attrs="{'invisible': [('discount_type', '!=', 'fixed')]}"
                            />
                        <field
                                name="discount_percentage"
                                attrs="{'invisible': [('discount_type', '!=', 'percentage')]}"
                            />
                    </group>
                    <field
                            name="discount_python_code"
                            widget="ace"
                            options="{'mode': 'python'}"
                            attrs="{'invisible': [('discount_type', '!=', 'python')]}"
                        />
                    <group
                            name="referrer_discount_group"
                            string="Referrer Discount"
                        >
                        <field name="referrer_discount_type" />
                        <field
                                name="referrer_discount_amount"
                                attrs="{'invisible': [('referrer_discount_type', '!=', 'fixed')]}"
                            />
                        <field
                                name="referrer_discount_percentage"
                                attrs="{'invisible': [('referrer_discount_type', '!=', 'percentage')]}"
                            />
                    </group>
                    <field
                            name="referrer_discount_python_code"
                            widget="ace"
                            options="{'mode': 'python'}"
                            attrs="{'invisible': [('referrer_discount_type', '!=', 'python')]}"
                        />
                </page>
                <page name="limits" string="Usage &amp; Validity">
                    <group name="limits_group" string="Limits &amp; Validity">
                        <field name="usage_limit" />
                        <field name="has_validity" />
                        <field
                                name="validity_duration"
                                attrs="{'invisible': [('has_validity', '=', False)], 'required': [('has_validity', '=', True)]}"
                            />
                    </group>
                    <field
                            name="validity_python_code"
                            widget="ace"
                            options="{'mode': 'python'}"
                        />
                </page>
                <page name="reference" string="Reference Documents">
                    <field name="allowed_model_ids" widget="many2many_tags" />
                </page>
                <page name="allocation_account" string="Allocation Account">
                    <group
                            name="allocation_account_group"
                            colspan="4"
                            col="2"
                            string="Allocation Account"
                        >
                        <field name="allocation_account_selection_method" />
                        <field
                                name="allocation_account_ids"
                                widget="many2many_tags"
                                attrs="{'invisible': [('allocation_account_selection_method', '!=', 'manual')]}"
                            />
                        <field
                                name="allocation_account_domain"
                                widget="domain"
                                options="{'model': 'account.account', 'in_dialog': True}"
                                attrs="{'invisible': [('allocation_account_selection_method', '!=', 'domain')]}"
                            />
                        <field
                                name="allocation_account_python_code"
                                widget="ace"
                                options="{'mode': 'python'}"
                                attrs="{'invisible': [('allocation_account_selection_method', '!=', 'code')]}"
                            />
                    </group>
                </page>
                <page name="accounting" string="Discount Accounting">
                    <group name="accounting_customer_group" string="Customer Discount">
                        <field name="journal_id" />
                        <field name="product_id" />
                        <field name="discount_usage_id" />
                        <field name="account_id" />
                    </group>
                    <group name="accounting_referrer_group" string="Referrer Discount">
                        <field name="referrer_journal_id" />
                        <field name="referrer_product_id" />
                        <field name="referrer_discount_usage_id" />
                    </group>
                    <group
                            name="accounting_deferred_group"
                            string="Deferred Recognition"
                        >
                        <field name="recognition_method" />
                        <field
                                name="deferred_account_id"
                                attrs="{'invisible': [('recognition_method', '!=', 'deferred')]}"
                            />
                        <field
                                name="recognition_journal_id"
                                attrs="{'invisible': [('recognition_method', '!=', 'deferred')]}"
                            />
                    </group>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="promotion_type_action" model="ir.actions.act_window">
    <field name="name">Promotion Types</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">promotion_type</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="promotion_type_menu"
        name="Types"
        parent="menu_promotion_configuration"
        action="promotion_type_action"
        groups="promotion_type_group"
        sequence="10"
    />
</odoo>
