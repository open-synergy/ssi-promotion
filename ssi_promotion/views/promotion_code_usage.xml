<odoo>
<record id="promotion_code_usage_view_search" model="ir.ui.view">
    <field name="name">promotion_code_usage - search</field>
    <field name="model">promotion_code_usage</field>
    <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="promotion_code_id" />
                <field name="type_id" />
                <field name="partner_id" />
                <field name="date" />
            </xpath>
            <xpath expr="//group[@name='group_by']" position="inside">
                <filter
                        name="grp_promotion_code"
                        string="Promotion Code"
                        context="{'group_by':'promotion_code_id'}"
                    />
                <filter
                        name="grp_type"
                        string="Type"
                        context="{'group_by':'type_id'}"
                    />
                <filter
                        name="grp_partner"
                        string="Voucher User"
                        context="{'group_by':'partner_id'}"
                    />
            </xpath>
        </data>
    </field>
</record>

<record id="promotion_code_usage_view_tree" model="ir.ui.view">
    <field name="name">promotion_code_usage - tree</field>
    <field name="model">promotion_code_usage</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="promotion_code_id" />
                <field name="type_id" />
                <field name="partner_id" />
                <field name="date" />
                <field name="document_reference" />
                <field name="discount_amount" sum="Total" />
            </xpath>
        </data>
    </field>
</record>

<record id="promotion_code_usage_view_form" model="ir.ui.view">
    <field name="name">promotion_code_usage - form</field>
    <field name="model">promotion_code_usage</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="promotion_code_id" />
                <field name="type_id" invisible="1" />
                <field name="partner_id" />
            </xpath>
            <xpath expr="//group[@name='header_right']" position="inside">
                <field name="date" />
                <field name="document_reference" />
                <field name="referrer_document_reference" />
            </xpath>
            <xpath expr="//page[1]" position="before">
                <page name="discount" string="Discount &amp; Accounting Entry">
                    <group name="promotion_code_usage_discount_group" string="Discount">
                        <field name="discount_amount" />
                        <field name="referrer_discount_amount" />
                    </group>
                    <group
                            name="promotion_code_usage_recognition_group"
                            string="Recognition"
                        >
                        <field name="recognition_method" />
                        <field name="recognition_date" />
                        <field
                                name="deferred_account_id"
                                attrs="{'invisible': [('recognition_method', '!=', 'deferred')]}"
                            />
                        <field
                                name="recognition_journal_id"
                                attrs="{'invisible': [('recognition_method', '!=', 'deferred')]}"
                            />
                        <field
                                name="amount_to_recognize"
                                attrs="{'invisible': [('recognition_method', '!=', 'deferred')]}"
                            />
                        <field
                                name="amount_recognized"
                                attrs="{'invisible': [('recognition_method', '!=', 'deferred')]}"
                            />
                        <field
                                name="amount_deferred"
                                attrs="{'invisible': [('recognition_method', '!=', 'deferred')]}"
                            />
                        <field
                                name="recognition_state"
                                attrs="{'invisible': [('recognition_method', '!=', 'deferred')]}"
                            />
                    </group>
                    <group
                            name="promotion_code_usage_referrer_recognition_group"
                            string="Referrer Recognition"
                        >
                        <field name="referrer_recognition_method" />
                        <field name="referrer_recognition_date" />
                        <field
                                name="referrer_deferred_account_id"
                                attrs="{'invisible': [('referrer_recognition_method', '!=', 'deferred')]}"
                            />
                        <field
                                name="referrer_recognition_journal_id"
                                attrs="{'invisible': [('referrer_recognition_method', '!=', 'deferred')]}"
                            />
                    </group>
                    <group
                            name="promotion_code_usage_accounting_entry_group"
                            string="Accounting Entry"
                        >
                        <field name="move_id" />
                        <field name="receivable_move_line_id" />
                        <field name="referrer_move_id" />
                        <field name="referrer_receivable_move_line_id" />
                    </group>
                </page>
                <page name="allocation" string="Allocation">
                    <button
                            name="action_populate_allocation"
                            string="Populate Allocation"
                            class="oe_highlight"
                            icon="fa-magic"
                            type="object"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"
                        />
                    <field
                            name="allocation_ids"
                            colspan="4"
                            nolabel="1"
                            attrs="{'readonly': [('state', '!=', 'draft')]}"
                        >
                        <tree editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="source" />
                            <field
                                    name="move_line_id"
                                    domain="[('account_id.reconcile', '=', True), ('parent_state', '=', 'posted'), ('reconciled', '=', False), ('amount_residual', '>', 0), ('account_id', 'in', allowed_account_ids)]"
                                />
                            <field name="move_id" />
                            <field name="partner_id" />
                            <field name="amount_residual" widget="monetary" />
                            <field name="partial_reconcile_id" />
                            <field name="amount_reconciled" widget="monetary" />
                            <field name="account_id" invisible="1" />
                            <field name="currency_id" invisible="1" />
                            <field name="company_currency_id" invisible="1" />
                            <field name="allowed_account_ids" invisible="1" />
                        </tree>
                        <form>
                            <group col="2">
                                <field name="sequence" />
                                <field name="source" />
                                <field
                                        name="move_line_id"
                                        domain="[('account_id.reconcile', '=', True), ('parent_state', '=', 'posted'), ('reconciled', '=', False), ('amount_residual', '>', 0), ('account_id', 'in', allowed_account_ids)]"
                                    />
                                <field name="move_id" />
                                <field name="account_id" />
                                <field name="partner_id" />
                                <field name="amount_residual" widget="monetary" />
                                <field name="partial_reconcile_id" />
                                <field name="amount_reconciled" widget="monetary" />
                                <field name="currency_id" invisible="1" />
                                <field name="company_currency_id" invisible="1" />
                                <field name="allowed_account_ids" invisible="1" />
                            </group>
                        </form>
                    </field>
                </page>
                <page
                        name="recognitions"
                        string="Recognitions"
                        attrs="{'invisible': [('recognition_method', '!=', 'deferred')]}"
                    >
                    <field name="recognition_ids" colspan="4" nolabel="1">
                        <tree create="false" edit="false" delete="false">
                            <field name="date" />
                            <field name="amount" widget="monetary" />
                            <field name="ratio" widget="percentage" />
                            <field name="state" />
                            <field name="currency_id" invisible="1" />
                        </tree>
                        <form create="false" edit="false" delete="false">
                            <group col="2">
                                <field name="date" />
                                <field name="amount" widget="monetary" />
                                <field name="ratio" widget="percentage" />
                                <field name="journal_id" />
                                <field name="move_id" />
                                <field name="state" />
                                <field name="currency_id" invisible="1" />
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="promotion_code_usage_action" model="ir.actions.act_window">
    <field name="name">Promotion Code Usages</field>
    <field name="res_model">promotion_code_usage</field>
    <field name="view_mode">tree,form</field>
    <field
            name="context"
        >{'search_default_dom_draft':1,'search_default_dom_confirm':1,'search_default_dom_open':1}</field>
</record>

<menuitem
        id="promotion_code_usage_menu"
        name="Usages"
        parent="menu_root_promotion"
        action="promotion_code_usage_action"
        groups="promotion_code_usage_viewer_group"
        sequence="20"
    />
</odoo>
