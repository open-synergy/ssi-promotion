<odoo noupdate="1">
<record
        id="sequence_template_promotion_code_usage_recognition"
        model="sequence.template"
    >
    <field name="name">Standard</field>
    <field name="model_id" ref="model_promotion_code_usage_recognition" />
    <field name="sequence" eval="100" />
    <field name="initial_string">/</field>
    <field
            name="sequence_field_id"
            search="[('model_id.model','=','promotion_code_usage_recognition'),('name','=','name')]"
        />
    <field
            name="date_field_id"
            search="[('model_id.model','=','promotion_code_usage_recognition'),('name','=','date')]"
        />
    <field name="computation_method">use_python</field>
    <field name="python_code">result=True</field>
    <field name="sequence_id" ref="sequence_promotion_code_usage_recognition" />
    <field name="sequence_selection_method">use_sequence</field>
    <field name="add_custom_prefix" eval="0" />
    <field name="add_custom_suffix" eval="0" />
</record>
</odoo>
