<odoo>
<record id="promotion_code_usage_action_done" model="ir.actions.server">
    <field name="name">Action Done</field>
    <field name="model_id" ref="model_promotion_code_usage" />
    <field name="state">code</field>
    <field
            name="code"
        >records.with_context(bypass_policy_check=True).action_done()</field>
</record>

<record id="promotion_code_usage_action_open" model="ir.actions.server">
    <field name="name">Action Open</field>
    <field name="model_id" ref="model_promotion_code_usage" />
    <field name="state">code</field>
    <field
            name="code"
        >records.with_context(bypass_policy_check=True).action_open()</field>
</record>
</odoo>
