<!-- Restart Approval -->
<record
        id="policy_template_promotion_code_usage_recognition_restart_approval"
        model="policy.template_detail"
    >
    <field name="template_id" ref="policy_template_promotion_code_usage_recognition" />
    <field
            name="field_id"
            search="[('model_id.model','=','promotion_code_usage_recognition'),('name','=','restart_approval_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','promotion_code_usage_recognition'),('value','=','confirm')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field
            name="group_ids"
            eval="[(6,0,[ref('promotion_code_usage_recognition_validator_group')])]"
        />
    <field name="restrict_additional" eval="1" />
    <field
            name="additional_python_code"
        >result = not document.approval_template_id</field>
</record>

