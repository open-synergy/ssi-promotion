            name="field_id"
            search="[('model_id.model','=','promotion_code_usage_recognition'),('name','=','cancel_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','promotion_code_usage_recognition'),('value','in',['draft','confirm','done'])]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field
            name="group_ids"
            eval="[(6,0,[ref('promotion_code_usage_recognition_validator_group')])]"
        />
