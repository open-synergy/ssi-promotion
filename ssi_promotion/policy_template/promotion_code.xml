<odoo>
<record id="policy_template_promotion_code" model="policy.template">
    <field name="name">Standard</field>
    <field name="model_id" ref="model_promotion_code" />
    <field
            name="state_field_id"
            search="[('model_id.model','=','promotion_code'),('name','=','state')]"
        />
    <field name="sequence" eval="100" />
    <field name="python_code">result=True</field>
</record>

<!-- Confirm -->
<record id="policy_template_promotion_code_confirm" model="policy.template_detail">
    <field name="template_id" ref="policy_template_promotion_code" />
    <field
            name="field_id"
            search="[('model_id.model','=','promotion_code'),('name','=','confirm_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','promotion_code'),('value','=','draft')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('promotion_code_user_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

<!-- Approve -->
<record id="policy_template_promotion_code_approve" model="policy.template_detail">
    <field name="template_id" ref="policy_template_promotion_code" />
    <field
            name="field_id"
            search="[('model_id.model','=','promotion_code'),('name','=','approve_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','promotion_code'),('value','=','confirm')]"
        />
    <field name="restrict_user" eval="0" />
    <field name="restrict_additional" eval="1" />
    <field name="additional_python_code">result = False
if env.user.id in document.active_approver_user_ids.ids:
    result = True</field>
</record>

<!-- Reject -->
<record id="policy_template_promotion_code_reject" model="policy.template_detail">
    <field name="template_id" ref="policy_template_promotion_code" />
    <field
            name="field_id"
            search="[('model_id.model','=','promotion_code'),('name','=','reject_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','promotion_code'),('value','=','confirm')]"
        />
    <field name="restrict_user" eval="0" />
    <field name="restrict_additional" eval="1" />
    <field name="additional_python_code">result = False
if env.user.id in document.active_approver_user_ids.ids:
    result = True</field>
</record>

<!-- Done -->
<record id="policy_template_promotion_code_done" model="policy.template_detail">
    <field name="template_id" ref="policy_template_promotion_code" />
    <field
            name="field_id"
            search="[('model_id.model','=','promotion_code'),('name','=','done_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','promotion_code'),('value','=','open')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('promotion_code_user_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

<!-- Cancel -->
<record id="policy_template_promotion_code_cancel" model="policy.template_detail">
    <field name="template_id" ref="policy_template_promotion_code" />
    <field
            name="field_id"
            search="[('model_id.model','=','promotion_code'),('name','=','cancel_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','promotion_code'),('value','in',['draft','confirm','open'])]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('promotion_code_validator_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

<!-- Restart -->
<record id="policy_template_promotion_code_restart" model="policy.template_detail">
    <field name="template_id" ref="policy_template_promotion_code" />
    <field
            name="field_id"
            search="[('model_id.model','=','promotion_code'),('name','=','restart_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','promotion_code'),('value','in',['cancel','reject'])]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('promotion_code_validator_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

<!-- Manual Number -->
<record
        id="policy_template_promotion_code_manual_number"
        model="policy.template_detail"
    >
    <field name="template_id" ref="policy_template_promotion_code" />
    <field
            name="field_id"
            search="[('model_id.model','=','promotion_code'),('name','=','manual_number_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','promotion_code'),('value','=','draft')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('promotion_code_validator_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>
</odoo>
